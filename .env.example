# ==============================================
# Aapkakaam-server environment configuration.
# Copy this file to `.env` and fill in real values.
# NEVER commit `.env` to source control.
# ==============================================

# ---- Runtime -----------------------------------------------------------
NODE_ENV=production
PORT=3000
LOG_LEVEL=info
# Number of trusted proxies in front of the app (0 = none, 1 = ALB/nginx)
TRUST_PROXY=1

# ---- CORS --------------------------------------------------------------
# Comma-separated list of allowed origins (no trailing slash).
ALLOWED_ORIGINS=https://app.aapkakaam.com,https://admin.aapkakaam.com

# ---- MongoDB -----------------------------------------------------------
MONGODB_URL_1=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority
MONGO_MAX_POOL_SIZE=50
MONGO_MIN_POOL_SIZE=5
MONGO_CONNECT_TIMEOUT_MS=30000
MONGO_SOCKET_TIMEOUT_MS=45000
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000

# ---- JWT ---------------------------------------------------------------
# Fallback secret (dev only). In production the four per-audience secrets
# below are required.
JWT_SECRET=change-me-please-32+chars-random
JWT_USER_SECRET=change-me-please-32+chars-random
JWT_VENDOR_SECRET=change-me-please-32+chars-random
JWT_ADMIN_SECRET=change-me-please-32+chars-random
JWT_EMPLOYEE_SECRET=change-me-please-32+chars-random
JWT_EXPIRES_IN=72h
BCRYPT_ROUNDS=12

# ---- Rate limiting -----------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# ---- SMTP / OTP email --------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ---- Fast2SMS (SMS OTP) ------------------------------------------------
# Full URL including api key & auth token as used in existing controllers
FAST2SMS=

# ---- Admin -------------------------------------------------------------
ADMIN_EMAIL=admin@aapkakaam.com

# ---- AWS S3 ------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET=

# ---- Firebase (choose ONE) --------------------------------------------
# Option A: base64 of service account JSON (recommended for containers)
FIREBASE_SERVICE_ACCOUNT_JSON=
# Option B: absolute path to service account JSON file
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_PROJECT_ID=

# ---- Razorpay ----------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_SECRET=
MERCHANT_ACCOUNT_ID=
